          <a href="#healthcare" data-i18n="nav_health" class="px-2.5 py-1.5 rounded-lg hover:bg-slate-200/70 dark:hover:bg-slate-800 transition">Healthcare</a>
          <a href="#education" data-i18n="nav_edu" class="px-2.5 py-1.5 rounded-lg hover:bg-slate-200/70 dark:hover:bg-slate-800 transition">Education</a>
          <a href="#services" data-i18n="nav_services" class="px-2.5 py-1.5 rounded-lg hover:bg-slate-200/70 dark:hover:bg-slate-800 transition">Civic Services</a>
