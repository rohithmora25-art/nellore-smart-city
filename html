    function renderMapMarkers(filterLayer) {
      markersLayer.clearLayers();
      const colors = {
        hospital: '#e11d48',
        government: '#0284c7',
        emergency: '#f59e0b',
        education: '#10b981',
        transport: '#6366f1',
        park: '#14b8a6',
        development: '#8b5cf6'
      };

      nelloreLocations.forEach(loc => {
        if (filterLayer !== 'all' && loc.layer !== filterLayer) return;

        const color = colors[loc.layer] || '#0284c7';
        const markerHtml = `<div style="background:${color}; width:16px; height:16px; border-radius:9999px; border:3px solid white; box-shadow:0 2px 8px rgba(0,0,0,0.4);"></div>`;
        const icon = L.divIcon({ html: markerHtml, className: '', iconSize: [16, 16], iconAnchor: [8, 8] });

        const marker = L.marker([loc.lat, loc.lng], { icon }).addTo(markersLayer);
        marker.bindPopup(`<strong>${loc.name}</strong><br><span style="font-size:11px;color:#0284c7;">${loc.cat}</span>`);
        marker.on('click', () => inspectLocation(loc));
      });
    }

